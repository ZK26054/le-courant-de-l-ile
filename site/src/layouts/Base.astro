---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '../styles/global.css';
import { lien } from '../lib/chemins';

interface Props {
  titre: string;
  description: string;
}
const { titre, description } = Astro.props;
const titreComplet = titre === "Le courant de l'île" ? titre : `${titre} · Le courant de l'île`;
const chemin = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/+$/, ''), '') || '/';
const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/installations', label: 'Installations' },
  { href: '/reseau', label: 'Réseau' },
  { href: '/comprendre', label: 'Comprendre' },
  { href: '/articles', label: 'Articles' },
  { href: '/sources', label: 'Sources' },
];
const actif = (href: string) => (href === '/' ? chemin === '/' : chemin.startsWith(href));
const canonique = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta name="theme-color" content="#0A1C27" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F6F4EE" media="(prefers-color-scheme: light)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <link rel="icon" href={lien('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="conteneur entete-in">
        <a class="marque" href={lien('/')} aria-label="Le courant de l'île, accueil">
          <svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><path d="M17.5 3 8 18h7l-2.5 11L24 13h-7.2z" fill="var(--accent)" /></svg>
          <span>Le courant de l’île</span>
        </a>
        <nav aria-label="Navigation principale">
          <ul>
            {nav.map((n) => (
              <li><a href={lien(n.href)} aria-current={actif(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="pied">
      <div class="conteneur pied-in">
        <p><strong>Le courant de l’île</strong> — le système électrique de La Réunion, chiffres sourcés et datés.</p>
        <p class="discret">Aucun cookie, aucun traceur, aucune publicité. Polices et vidéos hébergées sur ce site. Seul l’encart « en direct » de l’accueil interroge l’open data d’EDF Réunion depuis votre navigateur.</p>
        <ul class="pied-liens">
          <li><a href={lien('/sources')}>Sources et méthode</a></li>
          <li><a href={lien('/mentions-legales')}>Mentions légales</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .entete { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--ligne); }
  .entete-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.25rem 1.5rem; padding-top: 0.6rem; padding-bottom: 0.6rem; }
  .marque { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--texte); text-decoration: none; font-family: var(--f-display); font-weight: 800; font-size: 1.15rem; min-height: 44px; }
  .logo { width: 1.6rem; height: 1.6rem; }
  nav { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  nav::-webkit-scrollbar { display: none; }
  @media (min-width: 56rem) { nav { width: auto; } }
  nav ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.7rem; border-radius: var(--rayon-s); color: var(--texte-2); text-decoration: none; font-weight: 500; white-space: nowrap; font-size: 0.97rem; }
  nav a:hover { color: var(--texte); background: var(--surface); }
  nav a[aria-current='page'] { color: var(--texte); box-shadow: inset 0 -2px 0 var(--accent); border-radius: 0; }
  main { min-height: 60vh; padding-bottom: 3rem; }
  .pied { border-top: 1px solid var(--ligne); padding: 2rem 0 2.5rem; font-size: 0.92rem; }
  .pied-liens { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding: 0; margin: 0; }
  .pied-liens a { display: inline-block; padding: 0.4rem 0; }
</style>
